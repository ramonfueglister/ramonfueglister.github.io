---
import Base from '../../layouts/Base.astro';

const posts = [
  {
    title: 'Mit einem KI-Agenten zum eigenen PICTS-Blog',
    description:
      'Wie ein KI-Agent Konzeption, Umsetzung und Veröffentlichung eines PICTS-Blogs unterstützt.',
    date: '10. September 2026',
    readingTime: 'ca. 20 Minuten',
    tags: ['KI-Agent', 'GitHub', 'PICTS'],
    href: '/blog/blog-mit-chatgpt-und-github/',
  },
];
---

<Base
  title="Blog – Ramon Füglister"
  description="Blog von Ramon Füglister"
>
  <header class="blog-hero">
    <h1>Blog</h1>
  </header>

  <section class="posts" aria-labelledby="posts-title">
    <div class="section-head">
      <p>Beiträge</p>
      <span>{posts.length.toString().padStart(2, '0')}</span>
    </div>
    <h2 id="posts-title" class="sr-only">Alle Blogbeiträge</h2>
    <ol>
      {posts.map((post, index) => (
        <li>
          <a href={post.href} class="post-card">
            <span class="number">{String(index + 1).padStart(2, '0')}</span>
            <span class="post-copy">
              <span class="meta">{post.date} · {post.readingTime}</span>
              <span class="title">{post.title}</span>
              <span class="description">{post.description}</span>
              <span class="tags">
                {post.tags.map((tag) => <span>{tag}</span>)}
              </span>
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .blog-hero,
  .posts {
    width: min(100%, var(--max));
    margin-inline: auto;
    padding-inline: var(--pad);
  }

  .blog-hero {
    padding-top: clamp(5rem, 10vw, 8rem);
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }

  h1 {
    font-size: clamp(4rem, 12vw, 9.5rem);
    letter-spacing: -0.04em;
    line-height: 0.78;
  }

  .posts {
    padding-bottom: clamp(6rem, 12vw, 10rem);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
    color: var(--aegean);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  ol {
    list-style: none;
  }

  .post-card {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }

  .number {
    color: var(--terra);
    font-family: var(--serif);
    font-size: 1.25rem;
    font-style: italic;
  }

  .post-copy,
  .title,
  .description,
  .tags {
    display: block;
  }

  .meta {
    display: block;
    margin-bottom: 0.75rem;
    color: rgba(16, 37, 74, 0.6);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .title {
    max-width: 16ch;
    font-family: var(--serif);
    font-size: clamp(2rem, 5vw, 3.7rem);
    line-height: 0.98;
    transition: color 0.25s ease;
  }

  .post-card:hover .title {
    color: var(--aegean);
  }

  .description {
    max-width: 44rem;
    margin-top: 1.25rem;
    color: rgba(16, 37, 74, 0.76);
  }

  .tags {
    margin-top: 1.25rem;
  }

  .tags span {
    display: inline-block;
    margin: 0 0.4rem 0.4rem 0;
    padding: 0.18rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.72rem;
  }

  .arrow {
    color: var(--aegean);
    font-size: 2rem;
    transition: transform 0.25s ease;
  }

  .post-card:hover .arrow {
    transform: translateX(0.4rem);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  @media (max-width: 720px) {
    .post-card {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .arrow {
      display: none;
    }
  }
</style>
