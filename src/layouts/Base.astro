---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Blog von Ramon Füglister',
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Zum Inhalt</a>
    <header class="site-header">
      <nav class="nav" aria-label="Hauptnavigation">
        <a class="brand" href="/blog/">Blog</a>
      </nav>
    </header>

    <main id="content"><slot /></main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Ramon Füglister</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --white: #fff;
    --paper: #fff;
    --ink: #111827;
    --muted: #667085;
    --blue: #064bc4;
    --aegean: #064bc4;
    --terra: #064bc4;
    --line: #d9dee7;
    --serif: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --sans: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --pad: clamp(1.25rem, 4vw, 4rem);
    --max: 1280px;
  }

  @view-transition { navigation: auto; }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: white; }
  body { margin: 0; overflow-x: hidden; color: var(--ink); background: white; font: 400 1rem/1.55 var(--sans); -webkit-font-smoothing: antialiased; }
  h1, h2, h3, p, ul, ol, dl { margin: 0; }
  h1, h2, h3 { font-weight: 500; }
  a { color: inherit; text-decoration: none; }
  button { color: inherit; font: inherit; }
  img, svg { display: block; max-width: 100%; }
  ::selection { color: white; background: var(--blue); }
  :focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
  .container { width: min(100%, var(--max)); margin-inline: auto; padding-inline: var(--pad); }
  .skip-link { position: fixed; z-index: 1000; top: .75rem; left: .75rem; padding: .7rem 1rem; color: white; background: var(--blue); transform: translateY(-150%); }
  .skip-link:focus { transform: none; }

  .site-header { position: sticky; z-index: 100; top: 0; background: rgba(255,255,255,.94); backdrop-filter: blur(14px); }
  .nav { display: flex; align-items: center; justify-content: space-between; width: min(100%, var(--max)); min-height: 64px; margin-inline: auto; padding-inline: var(--pad); border-bottom: 1px solid var(--line); }
  .brand { font-size: .85rem; font-weight: 600; letter-spacing: -.01em; }
  .site-footer { width: min(100%, var(--max)); margin-inline: auto; padding: 2rem var(--pad); border-top: 1px solid var(--line); color: var(--muted); font-size: .75rem; }

  @media (max-width: 700px) {
    .nav { min-height: 58px; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition-duration: .001ms !important; }
  }
</style>
